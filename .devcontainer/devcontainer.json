{
  "name": "PlayStation41 - Go 1.25 & Ebitengine",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go"
      },
      "extensions": [
        "golang.go"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "go mod download"
}